<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BZ.ViewModels"
             xmlns:model="clr-namespace:Domain.Models;assembly=Domain"
             x:DataType="vm:ProcedureFormViewModel"
             x:Class="BZ.Pages.ProcedureFormPage"
             Title="Форма для процедуры"
             Shell.BackgroundColor="#1D1616"
             Shell.TitleColor="#D3DAD9">
    <Shell.BackButtonBehavior>
                <BackButtonBehavior Command="{Binding BackCommand}" />
    </Shell.BackButtonBehavior>
    <VerticalStackLayout Padding="30" Spacing="10" BackgroundColor="#1D1616">
        <Entry TextColor="White" BackgroundColor="#44444E"  Placeholder="Название процедуры"
               Text="{Binding ProcedureName}"/>
        <Button TextColor="White" BackgroundColor="#CC561E" Text="Сохранить" Command="{Binding SubmitCommand}"/>
    </VerticalStackLayout>
</ContentPage>