<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:model="clr-namespace:Domain.Models;assembly=Domain"
             xmlns:vm="clr-namespace:BZ.ViewModels;assembly=BZ"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:ProcedurePageViewModel"
             x:Class="BZ.Pages.ProcedurePage"
             x:Name="PageRoot"
             Title="Процедуры"
             Shell.BackgroundColor="#F2F2F2"
             Shell.TitleColor="#31304D">
   
    <Grid BackgroundColor="#F2F2F2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <VerticalStackLayout>
            <RefreshView Grid.Row="1"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView
                    Grid.Row="1"
                    BackgroundColor="#F2F2F2"
                    ItemsSource="{Binding Procedures}"
                    SelectionMode="Single"
                    SelectionChanged="OnProcedureSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Procedure">
                            <SwipeView Threshold="120">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItemView>
                                            <Button  Text="Удалить" BackgroundColor="Red" Margin="2" CornerRadius="25"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProcedurePageViewModel}},
                                                     Path=DeleteCommand}"
                                                     CommandParameter="{Binding .}" />
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Frame Margin="10" Padding="25" CornerRadius="25" BackgroundColor="#FBFBFB">
                                    <Label HorizontalOptions="Center" FontSize="20"
                                           Text="{Binding Name}"
                                           TextColor="Black"/>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            
            <Frame VerticalOptions="End" Margin="10" Padding="25" CornerRadius="25" BackgroundColor="#FBFBFB">
                <Button HorizontalOptions="Center" FontSize="20" BackgroundColor="Transparent"
                        Text="Создать" TextColor="Black" 
                        Command="{Binding OpenProcedurePopupCommand}"
                        CommandParameter="{Binding NewProcedure}"/>
            </Frame>
            
        </VerticalStackLayout>
        
        
        
        <!-- Overlay loader (центр экрана) -->
        <Grid Grid.RowSpan="2"
          IsVisible="{Binding IsLoading}"
          BackgroundColor="#D2E0FB"
          InputTransparent="False">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           WidthRequest="48" HeightRequest="48" Color="#749BC2"/>
        </Grid>
    </Grid>

</ContentPage>