<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BZ.ViewModels;assembly=BZ"
             x:Class="BZ.Pages.HomePage"
             x:DataType="vm:HomePageViewModel"
             Title="Главная"
             Shell.BackgroundColor="#F2F2F2"
             Shell.TitleColor="#31304D">
    <VerticalStackLayout Margin="2" Padding="30" Spacing="25" BackgroundColor="#F2F2F2">
        <Label Text="Админ Панель" FontSize="32" HorizontalOptions="Center" IsVisible="{Binding IsAdmin}"/>
        <Button BackgroundColor="#B6BBC4" TextColor="#31304D" Text="Процедуры" Command="{Binding NavigateToProceduresPageCommand}"/>
        <Button BackgroundColor="#B6BBC4" TextColor="#31304D" Text="Мастера" Command="{Binding NavigateToBeautyTechPageCommand}"/>
        <Button BackgroundColor="#B6BBC4" TextColor="#31304D" Text="Клиенты" Command="{Binding NavigateToCustomerPageCommand}"/>
        <Button BackgroundColor="#B6BBC4" TextColor="#31304D" Text="Выйти" Command="{Binding Source={RelativeSource  AncestorType={x:Type vm:HomePageViewModel}}, Path=LogoutCommand}"/>

    </VerticalStackLayout>
</ContentPage>