<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BZ.ViewModels;assembly=BZ"
             x:Class="BZ.Pages.HomePage"
             x:DataType="vm:HomePageViewModel"
             Title="Главная"
             Shell.BackgroundColor="#1D1616"
             Shell.TitleColor="#D3DAD9">
    <VerticalStackLayout Margin="2" Padding="30" Spacing="25" BackgroundColor="#1D1616">
        <Label Text="Админ Панель" FontSize="32" HorizontalOptions="Center" IsVisible="{Binding IsAdmin}"/>
        <Button BackgroundColor="#44444E" TextColor="White" Text="Процедуры" Command="{Binding NavigateToProceduresPageCommand}"/>
        <Button BackgroundColor="#44444E" TextColor="White" Text="Выйти" Command="{Binding Source={RelativeSource  AncestorType={x:Type vm:HomePageViewModel}}, Path=LogoutCommand}"/>

    </VerticalStackLayout>
</ContentPage>