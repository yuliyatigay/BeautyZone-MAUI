<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BZ.ViewModels;assembly=BZ"
             x:DataType="vm:LoginPageViewModel"
             x:Class="BZ.Pages.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout>
        <Label Text="Введите данные для авторизации" HorizontalTextAlignment="Center" Margin="0,5"/>
        <Entry Text="{Binding Email}" Placeholder="Email"/>
        <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" Margin="0,0,0,30"/>
        <Button Text="Войти" Command="{Binding LoginCommand}"/>
    </VerticalStackLayout>
</ContentPage>