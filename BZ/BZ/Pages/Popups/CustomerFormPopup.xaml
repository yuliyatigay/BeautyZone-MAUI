<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="BZ.Pages.Popups.CustomerFormPopup"
    x:Name="PopupRoot">
    
    <Frame
        Padding="0"
        CornerRadius="16"
        BackgroundColor="White"
        HasShadow="True"
        WidthRequest="300">

        <VerticalStackLayout Spacing="16" Padding="20">

            <!-- кнопка закрыть -->
            <Grid Padding="0">
                <Label Text="{Binding PopupTitle}"
                       FontSize="16"
                       TextColor="Gray"
                       VerticalOptions="Center"/>
                <Button
                    Clicked="OnCancelClicked"
                    Text="✕"
                    FontSize="14"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    HorizontalOptions="End"
                    WidthRequest="32"
                    HeightRequest="32"
                    Padding="0"/>
            </Grid>

            <!-- поле ввода -->
            <Entry
                TextColor="#31304D"
                BackgroundColor="#F2F2F2"
                Placeholder="Имя клиента"
                Text="{Binding Customer.Name}" />
            <Entry
                TextColor="#31304D"
                BackgroundColor="#F2F2F2"
                Placeholder="Номер телефона"
                Keyboard="Telephone" MaxLength="12"
                Text="{Binding Customer.PhoneNumber}" />

            <!-- кнопка сохранить -->
            <Button
                Text="Сохранить"
                BackgroundColor="#8EACCD"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnDoneClicked"/>

        </VerticalStackLayout>

    </Frame>
</toolkit:Popup>